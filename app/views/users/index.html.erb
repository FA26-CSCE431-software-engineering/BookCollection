<p style="color: green"><%= notice %></p>

<h1>Users</h1>

<div id="users">
  <% @users.each do |user| %>
    <div>
      <%= user.username %>
      <%= link_to "Show", user %>
      <%= link_to "Edit", edit_user_path(user) %>
      <%= link_to "Destroy", user,
            data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
    </div>
  <% end %>
</div>

<%= link_to "New user", new_user_path %>

<%= link_to 'Back', root_path %>