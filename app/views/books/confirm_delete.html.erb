<h1>Delete Book</h1>

<p>Are you sure you want to delete this book?</p>

<p> Title: <%= @book.title %></p>

<br>

<%= button_to "Yes, Delete This Book", @book,
      method: :delete,
      data: { turbo_confirm: "This action cannot be undone. Are you sure?" }%>

<br>

<%= link_to "Cancel", books_path %>