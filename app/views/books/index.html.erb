<p style="color: green"><%= notice %></p>

<% content_for :title, "Books" %>

<h1>Books</h1>

<%= link_to "Add a New Book", new_book_path %>

<hr>

<% if @books.empty? %>
  <p>No books yet. Click "Add a New Book" to get started.</p>
<% else %>
  <% @books.each do |book| %>
    <div>
      <strong><%= book.title %></strong>
      <%= link_to "Show", book %>
      <%= link_to "Edit", edit_book_path(book) %>
      <%= link_to "Delete", book,
            data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this book?" } %>
    </div>
  <% end %>
<% end %>