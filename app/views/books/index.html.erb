<% content_for :title, "Books" %>

<h1>Books</h1>

<%= link_to "Add a New Book", new_book_path %>

<hr>

<% if @books.empty? %>
  <p>No books yet. Click "Add a New Book" to get started.</p>
<% else %>
  <% @books.each do |book| %>
    <div>
      <strong><%= book.title %></strong>
      Author: <%= book.author %><br>
      Price: $<%= book.price %><br>
      Published: <%= book.published_date %><br>
      <%= link_to "Show", book %>
      <%= link_to "Edit", edit_book_path(book) %>
      <%= button_to "Delete", book,method: :delete, data: { turbo_confirm: "Are you sure?" } %>
    </div>
  <% end %>
<% end %>